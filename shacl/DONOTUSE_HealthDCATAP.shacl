@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shape for dcat:Catalog
# Ensures the catalog has mandatory properties and contains datasets
:CatalogShape a sh:NodeShape ;
    sh:targetClass dcat:Catalog ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Catalog must have exactly one dct:title of type xsd:string" ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Catalog must have exactly one dct:description of type xsd:string" ;
    ] ;
    sh:property [
        sh:path dct:publisher ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Catalog must have exactly one dct:publisher as an IRI" ;
    ] ;
    sh:property [
        sh:path dcat:dataset ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        sh:message "Catalog should reference at least one dcat:Dataset" ;
    ] .

# Shape for dcat:Dataset
# Includes health-specific constraints (e.g., theme must include health-related URI)
:DatasetShape a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Dataset must have exactly one dct:title of type xsd:string" ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Dataset must have exactly one dct:description of type xsd:string" ;
    ] ;
    sh:property [
        sh:path dct:publisher ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Dataset must have exactly one dct:publisher as an IRI" ;
    ] ;
    sh:property [
        sh:path dcat:theme ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in ( <http://publications.europa.eu/resource/authority/data-theme/HEAL> ) ;
        sh:severity sh:Violation ;
        sh:message "Dataset must have at least one dcat:theme with the Health theme URI" ;
    ] ;
    sh:property [
        sh:path dct:license ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        sh:message "Dataset should have exactly one dct:license as an IRI" ;
    ] ;
    sh:property [
        sh:path dcat:distribution ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        sh:message "Dataset should have at least one dcat:Distribution" ;
    ] ;
    # Health-specific: Recommend dct:subject for medical classifications (e.g., ICD-10)
    sh:property [
        sh:path dct:subject ;
        sh:minCount 0 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Info ;
        sh:message "Dataset may include dct:subject with medical classification URIs (e.g., ICD-10)" ;
    ] .

# Shape for dcat:Distribution
# Ensures distributions have access URLs and formats
:DistributionShape a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [
        sh:path dcat:accessURL ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Distribution must have at least one dcat:accessURL as an IRI" ;
    ] ;
    sh:property [
        sh:path dct:format ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        sh:message "Distribution should have exactly one dct:format as an IRI" ;
    ] ;
    sh:property [
        sh:path dct:license ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        sh:message "Distribution should have exactly one dct:license as an IRI" ;
    ] .

# Shape for dcat:CatalogRecord
# Validates metadata about dataset entries
:CatalogRecordShape a sh:NodeShape ;
    sh:targetClass dcat:CatalogRecord ;
    sh:property [
        sh:path foaf:primaryTopic ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "CatalogRecord must have exactly one foaf:primaryTopic linking to a Dataset or Catalog" ;
    ] ;
    sh:property [
        sh:path dct:issued ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Warning ;
        sh:message "CatalogRecord should have exactly one dct:issued of type xsd:date" ;
    ] .